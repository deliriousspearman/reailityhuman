# Settings for the panel's API and worker. On the server this file is /srv/lab-deploy/lab-deploy.env:
# deploy.sh creates it on the first deploy with a generated database password and empty vCenter
# settings, and never overwrites it. Fill in the vCenter part, then re-run the pipeline (or
# `docker compose up -d` in /srv/lab-deploy). Keep it private: chmod 600.

# Database (generated on first deploy; the password must match the one PostgreSQL was created with).
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://labdeploy:change-me@postgres/labdeploy

# vCenter. The account needs the role described in docs/setup-vsphere.md.
VCENTER_HOST=vcenter.lab.example
VCENTER_USER=svc-labdeploy@vsphere.local
VCENTER_PASSWORD=
# 1 accepts vCenter's own self-signed certificate.
VCENTER_INSECURE=1
VCENTER_DATACENTER=Datacenter
# Cluster, or a standalone host's name, under the datacenter.
VCENTER_CLUSTER=Cluster
# Optional resource pool inside the cluster (empty: the cluster's root pool).
VCENTER_RESOURCE_POOL=
VCENTER_DATASTORE=datastore1
# VM folder for machines, under the datacenter's VM folder.
VCENTER_FOLDER=Labs/Machines
# The LAN port group machines join; they get an address from its DHCP server.
VCENTER_NETWORK=VM Network

# Limits.
MAX_MACHINES=10
MAX_PERMANENT=3
# How long an expired machine is kept, powered off, before it's deleted (minutes).
GRACE_MINUTES=1440
# How long a deploy waits for the machine to report an IP address (seconds).
IP_TIMEOUT_SECONDS=300
