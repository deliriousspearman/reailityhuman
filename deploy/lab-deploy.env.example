# Settings for the panel's API and worker. On the server this file is /srv/lab-deploy/lab-deploy.env:
# deploy.sh creates it on the first deploy with a generated database password and empty vCenter
# settings, and never overwrites it. Fill in the vCenter part, then re-run the pipeline (or
# `docker compose up -d` in /srv/lab-deploy). Keep it private: chmod 600.

# Database (generated on first deploy; the password must match the one PostgreSQL was created with).
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://labdeploy:change-me@postgres/labdeploy

# vCenter. The account needs the role described in docs/setup-vsphere.md.
VCENTER_HOST=vcenter.lab.example
VCENTER_USER=svc-labdeploy@vsphere.local
VCENTER_PASSWORD=
# 1 accepts vCenter's own self-signed certificate.
VCENTER_INSECURE=1
VCENTER_DATACENTER=Datacenter
# Cluster, or a standalone host's name, under the datacenter.
VCENTER_CLUSTER=Cluster
# Optional resource pool inside the cluster (empty: the cluster's root pool).
VCENTER_RESOURCE_POOL=
VCENTER_DATASTORE=datastore1
# VM folder for machines, under the datacenter's VM folder.
VCENTER_FOLDER=Labs/Machines
# The LAN port group machines join; they get an address from its DHCP server.
VCENTER_NETWORK=VM Network

# Templates on demand (docs/plan.md, section 11): an admin can delete a template no machine uses, and
# the next deploy builds it again (the builder service, with VCENTER_USER: scripts/setup_vcenter.py
# gives that account what Packer needs). Where templates are, and the datastore folder of their ISOs.
VCENTER_TEMPLATE_FOLDER=Labs/Templates
VCENTER_ISO_FOLDER=ISO
# This server's address on the LAN, which build VMs fetch their answer files from (empty: Packer's guess).
BUILD_HTTP_IP=
# Offline: the media folder scripts/isos/fetch-media.sh made, for the Windows builds (empty: they download).
BUILD_MEDIA_DIR=
# A build that takes longer is stopped (minutes).
BUILD_TIMEOUT_MINUTES=180

# Limits.
MAX_MACHINES=10
MAX_PERMANENT=3
# Memory machines may be given, as a multiple of the cluster's physical memory. 1 never
# overcommits; e.g. 1.5 on a small host where vCenter itself holds most of the memory.
MEMORY_OVERCOMMIT=1
# Datastore space deploys never use (GB): when the datastore fills, every VM writing to it is paused.
DATASTORE_RESERVE_GB=30
# What a new machine writes on its own (GB), as a linked clone; extras add their diskGB.
CLONE_DISK_GB=10
# How long an expired machine is kept, powered off, before it's deleted (minutes).
GRACE_MINUTES=1440
# How long a deploy waits for the machine to report an IP address (seconds).
IP_TIMEOUT_SECONDS=300
# How long a deploy waits for its extras (nginx, Apache…) to finish installing (seconds).
EXTRAS_TIMEOUT_SECONDS=600
# How long a Windows deploy waits for the machine to set up: sysprep, a restart, the user, then any
# extras (seconds).
WINDOWS_SETUP_TIMEOUT_SECONDS=1200
# Domain for default names, e.g. lab.example: a certificate for a machine "web01" with no domain name
# given is for web01.lab.example. Empty: just the machine's name.
MACHINE_DOMAIN=

# Packet captures between machines (docs/admin-guide.md, "Packet capture"): the capture appliance's VM
# in vCenter (packer/capture), whose address the panel reads from VMware Tools; or its address in
# CAPTURE_HOST instead. Both empty: captures are off.
CAPTURE_VM=
CAPTURE_HOST=
# The longest a capture may run (seconds) and its largest size (MB); how many may run at once, per
# person and in all; how many days finished ones are kept.
CAPTURE_MAX_SECONDS=600
CAPTURE_MAX_MB=50
CAPTURE_PER_OWNER=1
CAPTURE_TOTAL=3
CAPTURE_KEEP_DAYS=1
