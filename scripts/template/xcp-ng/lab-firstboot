#!/bin/bash
# The lab panel's first boot for XCP-ng templates (installed by prepare-xcp-ng.sh, run at each boot
# once XAPI is up). XCP-ng has no cloud-init for itself, so like ../legacy/lab-firstboot this reads the
# guestinfo.lab.* keys the panel sets (backend/app/cloudinit.py: legacy_guestinfo) through VMware
# Tools. At every boot, once XAPI answers:
#   1. makes sure the management network has an address: early in boot the bridge comes up with the
#      template's MAC address (from XAPI's cache), which ESXi doesn't let through, so its DHCP gets
#      nothing, and XAPI doesn't keep the adapter as management once it has a new MAC. So eth0 is made
#      the management interface again, switched to a placeholder static address and back to DHCP
#      (asking for DHCP when it's already DHCP does nothing), which starts its client on the right MAC.
# On a new machine, then:
#   2. sets the host's name, root's password (the machine's, as a SHA-512 hash) and SSH key, and makes
#      new SSH host keys;
#   3. writes /var/lib/lab-deploy/extras.status, which the panel waits for as the sign it's ready.
# It acts once per machine (guestinfo.lab.instance); a reset reverts the disk, so it runs again. The
# panel's user is root, XCP-ng's administrator (also Xen Orchestra's and XCP-ng Center's sign-in).
set -u

DIR=/var/lib/lab-deploy
LOG_DIR=/var/log/lab-deploy
mkdir -p "$DIR" "$LOG_DIR"
chmod 755 "$DIR" "$LOG_DIR"
exec >>"$LOG_DIR/firstboot.log" 2>&1
echo "== $(date -u '+%Y-%m-%d %H:%M:%S') lab-firstboot"

rpc() { vmware-rpctool "info-get guestinfo.lab.$1" 2>/dev/null; }
PATH=$PATH:/opt/xensource/bin

# XAPI takes a while after its service starts.
for _ in $(seq 60); do
	xe host-list --minimal >/dev/null 2>&1 && break
	sleep 5
done

# 1. The management network's address.
bridge_ip() { ip -4 -o addr show dev xenbr0 2>/dev/null | awk '{ print $4; exit }'; }
for _ in $(seq 12); do
	[ -n "$(bridge_ip)" ] && break
	sleep 5
done
if [ -z "$(bridge_ip)" ]; then
	# The clone's adapter (eth0, with its own MAC: clean-xcp-ng.sh made XAPI forget the template's)
	# becomes the management interface, by DHCP again.
	pif=$(xe pif-list device=eth0 --minimal)
	if [ -z "$pif" ]; then
		xe pif-scan host-uuid="$(xe host-list --minimal)"
		pif=$(xe pif-list device=eth0 --minimal)
	fi
	echo "No address on the management network: eth0 (PIF $pif) as management, by DHCP."
	xe pif-reconfigure-ip uuid="$pif" mode=static IP=192.0.2.250 netmask=255.255.255.0
	xe pif-reconfigure-ip uuid="$pif" mode=dhcp
	xe host-management-reconfigure pif-uuid="$pif"
	for _ in $(seq 24); do
		[ -n "$(bridge_ip)" ] && break
		sleep 5
	done
fi
echo "Management network: $(bridge_ip)"

instance=$(rpc instance)
if [ -z "$instance" ]; then
	echo "No panel data (guestinfo.lab.instance): nothing to do."
	exit 0
fi
if [ "$(cat "$DIR/instance" 2>/dev/null)" = "$instance" ]; then
	echo "Already set up for $instance."
	exit 0
fi

# 2. This machine's name, root's password and key, and SSH host keys.
host=$(rpc hostname)
echo "Setting up $instance: host $host"
uuid=$(xe host-list --minimal)
xe host-param-set uuid="$uuid" name-label="$host"
xe host-set-hostname-live host-uuid="$uuid" host-name="$host"
rpc password | sed 's/^/root:/' | chpasswd -e
key=$(rpc sshkey | base64 -d 2>/dev/null || true)
if [ -n "$key" ]; then
	mkdir -p /root/.ssh
	grep -qxF "$key" /root/.ssh/authorized_keys 2>/dev/null || echo "$key" >>/root/.ssh/authorized_keys
	chmod 700 /root/.ssh
	chmod 600 /root/.ssh/authorized_keys
fi
rm -f /etc/ssh/ssh_host_*
ssh-keygen -A
systemctl restart sshd

echo "$instance" >"$DIR/instance"
# 3. Empty: no extras on XCP-ng. Written last, in one go, readable by the panel.
tmp=$(mktemp "$DIR/status.XXXXXX")
chmod 644 "$tmp"
mv "$tmp" "$DIR/extras.status"
echo "Done."
