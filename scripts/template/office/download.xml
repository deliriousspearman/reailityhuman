<!--
  Outlook for the panel's Windows templates (the "outlook" extra): Office LTSC 2024's volume edition,
  64-bit, with every app but Outlook left out. It isn't activated: the panel has no licence for it.

  The steps to download it (on any Windows PC with internet) and build it into a template are in
  docs/setup-vsphere.md, "Optional: Office's files, for Outlook". In short: put this file and the
  Office Deployment Tool's setup.exe in a folder called office, run  setup.exe /download download.xml
  there, and pass that folder to prepare.ps1 -Office. For another language, change Language ID (e.g.
  en-gb) before downloading. Machines install from the template's copy with these settings (the
  extra adds the source, and installs silently).
-->
<Configuration>
  <Add OfficeClientEdition="64" Channel="PerpetualVL2024">
    <Product ID="ProPlus2024Volume">
      <Language ID="en-us" />
      <ExcludeApp ID="Access" />
      <ExcludeApp ID="Excel" />
      <ExcludeApp ID="Lync" />
      <ExcludeApp ID="OneDrive" />
      <ExcludeApp ID="OneNote" />
      <ExcludeApp ID="PowerPoint" />
      <ExcludeApp ID="Publisher" />
      <ExcludeApp ID="Word" />
    </Product>
  </Add>
  <!-- No internet: don't look for updates or try to activate. -->
  <Updates Enabled="FALSE" />
  <Property Name="AUTOACTIVATE" Value="0" />
  <Property Name="FORCEAPPSHUTDOWN" Value="TRUE" />
  <Property Name="SharedComputerLicensing" Value="0" />
</Configuration>
