#!/bin/bash
# The lab panel's first boot for legacy templates (installed by prepare-legacy.sh), on systems whose
# cloud-init is too old to read the panel's data from vCenter. Instead, it reads a few guestinfo keys
# the panel sets (backend/app/cloudinit.py: legacy_guestinfo) through VMware Tools, and:
#   - sets the hostname;
#   - creates the user, with the machine's password (as a SHA-512 hash) and SSH key, in the admin group;
#   - makes this machine's own SSH host keys, and lets people sign in with the password;
#   - writes /var/lib/lab-deploy/extras.status, which the panel waits for: the sign the machine is ready.
# It runs at every boot but acts once per machine (guestinfo.lab.instance); a reset reverts the disk to
# before the first boot, so it runs again.
set -u

DIR=/var/lib/lab-deploy
STATUS=$DIR/extras.status
LOG_DIR=/var/log/lab-deploy

mkdir -p "$DIR" "$LOG_DIR"
chmod 755 "$DIR" "$LOG_DIR"
exec >>"$LOG_DIR/firstboot.log" 2>&1
echo "== $(date -u '+%Y-%m-%d %H:%M:%S') lab-firstboot"

rpctool=$(command -v vmware-rpctool || echo /usr/bin/vmware-rpctool)
rpc() { "$rpctool" "info-get guestinfo.lab.$1" 2>/dev/null; }

# VMware Tools may still be starting.
instance=""
for _ in $(seq 60); do
	instance=$(rpc instance) && [ -n "$instance" ] && break
	sleep 2
done
if [ -z "$instance" ]; then
	echo "No panel data (guestinfo.lab.instance): nothing to do."
	exit 0
fi
if [ "$(cat "$DIR/instance" 2>/dev/null)" = "$instance" ]; then
	echo "Already set up for $instance."
	exit 0
fi

host=$(rpc hostname)
user=$(rpc username)
hash=$(rpc password)
group=$(rpc group)
key=$(rpc sshkey | base64 -d 2>/dev/null || true)
echo "Setting up $instance: host $host, user $user"

# The hostname, by whichever means the system has.
if command -v hostnamectl >/dev/null 2>&1; then
	hostnamectl set-hostname "$host"
else
	hostname "$host"
	echo "$host" >/etc/hostname
	[ -f /etc/sysconfig/network ] && sed -i "s/^HOSTNAME=.*/HOSTNAME=$host/" /etc/sysconfig/network
fi
grep -qE "[[:space:]]$host\$" /etc/hosts || echo "127.0.1.1 $host" >>/etc/hosts

# The user, its password and key, in the admin group (sudo, or wheel).
id "$user" >/dev/null 2>&1 || useradd -m -s /bin/bash "$user"
getent group "$group" >/dev/null && usermod -a -G "$group" "$user"
usermod -p "$hash" "$user"
if [ -n "$key" ]; then
	home=$(getent passwd "$user" | cut -d: -f6)
	mkdir -p "$home/.ssh"
	grep -qxF "$key" "$home/.ssh/authorized_keys" 2>/dev/null || echo "$key" >>"$home/.ssh/authorized_keys"
	chown -R "$user:" "$home/.ssh"
	chmod 700 "$home/.ssh"
	chmod 600 "$home/.ssh/authorized_keys"
	command -v restorecon >/dev/null && restorecon -R "$home/.ssh"
fi

# SSH: this machine's own host keys (clean-legacy.sh deleted the template's), and password sign-in.
if ssh-keygen -A >/dev/null 2>&1; then :; else
	for type in rsa dsa; do
		[ -f "/etc/ssh/ssh_host_${type}_key" ] || ssh-keygen -q -t "$type" -N "" -f "/etc/ssh/ssh_host_${type}_key"
	done
fi
sed -i -E 's/^#?PasswordAuthentication .*/PasswordAuthentication yes/' /etc/ssh/sshd_config
if command -v systemctl >/dev/null 2>&1; then
	systemctl restart sshd 2>/dev/null || systemctl restart ssh
else
	service sshd restart 2>/dev/null || service ssh restart
fi

echo "$instance" >"$DIR/instance"
# Empty: no extras on legacy templates. Written last, in one go, readable by the user (the panel
# reads it as them).
tmp=$(mktemp "$DIR/status.XXXXXX")
chmod 644 "$tmp"
mv "$tmp" "$STATUS"
echo "Done."
